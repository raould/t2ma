{
  "compilerOptions": {
    
    "lib": [
      "ESNext",
      "dom"
    ], 
    "rootDir": "tmp",
    "outDir": "dist", 
    "removeComments": true, 
    "target": "ES6", 
    
    "esModuleInterop": true, 
    "paths": {}, 
    
    "alwaysStrict": true, 
    "allowUnreachableCode": false, 
    "noImplicitAny": true, 
    "strictNullChecks": true, 
    
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true, 
    "noUnusedParameters": true 
  },
  "include": [
    "./tmp/*.ts"
  ],
  "exclude": [
    "node_modules/**/*"
  ]
}
